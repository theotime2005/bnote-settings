{
  "name": "bnote-settings",
  "version": "6.5.0-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "nuxi test",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "add-new-setting": "node ./scripts/add-new-setting.js",
    "translate": "node scripts/update-translations.js",
    "db:new-migration": "knex --knexfile ./server/db/knexfile.js  migrate:make --stub $PWD/db/template.js $migrationname",
    "db:create": "node --env-file-if-exists=.env ./server/db/create-database.js",
    "db:delete": "node --env-file-if-exists=.env ./server/db/drop-database.js",
    "db:empty": "node --env-file-if-exists=.env ./server/db/empty-database.js",
    "db:migrate": "knex --knexfile ./server/db/knexfile.js  migrate:latest",
    "db:rollback:latest": "knex --knexfile ./server/db/knexfile.js  migrate:down",
    "db:rollback:all": "knex --knexfile ./server/db/knexfile.js  migrate:rollback",
    "db:prepare": "npm run db:delete && npm run db:create && npm run db:migrate",
    "db:seed": "knex --knexfile ./server/db/knexfile.js seed:run",
    "db:new-seed": "knex --knexfile ./server/db/knexfile.js seed:make --stub $PWD/db/seeds-template.js $seedname",
    "db:reset": "npm run db:prepare && npm run db:seed"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vercel/flags-core": "^1.10.0",
    "dotenv": "^18.0.7",
    "js-cookie": "^3.0.8",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "marked": "^18.0.14",
    "nodemailer": "^10.1.4",
    "nuxt": "^4.6.2",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/test-utils": "^4.3.2",
    "@pinia/testing": "^2.0.1",
    "@unhead/vue": "^3.3.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-knex": "^0.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vitest-globals": "^1.6.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "eslint-plugin-yml": "^3.9.0",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "vitest": "^5.0.1",
    "vue-router": "^5.3.1",
    "yargs": "^18.1.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
